{% comment %}
  Desire17 promises: Waarom Desire17 header + beloftes cards.
  Portable: inline <style>, no theme snippet dependencies except desire-icon.
{% endcomment %}

<div
  class="section section--full-width desire-promises desire-promises--width-{{ section.settings.section_width | default: 'full-width' }}"
  style="background-color: {{ section.settings.background_color | default: '#C49AAD' }}; margin-block-start: {{ section.settings.spacing_top | default: 0 }}px; margin-block-end: {{ section.settings.spacing_bottom | default: 0 }}px;"
>
  <div class="desire-promises__inner">
    <div class="desire-promises__head">
      {% if section.settings.heading != blank %}
        <h2 class="desire-promises__heading">{{ section.settings.heading }}</h2>
        <span class="desire-promises__underline" aria-hidden="true"></span>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <div class="desire-promises__sub">{{ section.settings.subtext }}</div>
      {% endif %}
    </div>
    {% if section.settings.badge_text != blank %}
      <p class="desire-promises__badge">{{ section.settings.badge_text | escape }}</p>
    {% endif %}
    <ul class="desire-promises__grid" role="list">
      <li class="desire-promises__card">
        <span class="desire-promises__check" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path d="M7.5 13.2 4 9.7 2.6 11.1l4.9 4.9L17.4 6.1 16 4.7Z" /></svg>
        </span>
        <span>{{ section.settings.card_1 | escape }}</span>
      </li>
      <li class="desire-promises__card">
        <span class="desire-promises__check" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path d="M7.5 13.2 4 9.7 2.6 11.1l4.9 4.9L17.4 6.1 16 4.7Z" /></svg>
        </span>
        <span>{{ section.settings.card_2 | escape }}</span>
      </li>
    </ul>
  </div>
</div>

<style>
  .desire-promises {
    color: #2b1a24;
  }

  .desire-promises__inner {
    padding: 56px 20px;
  }

  .desire-promises--width-page-width .desire-promises__inner {
    max-width: 1100px;
    margin-inline: auto;
  }

  .desire-promises--width-full-width .desire-promises__inner {
    max-width: 1100px;
    margin-inline: auto;
  }

  .desire-promises__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .desire-promises__heading {
    font-family: var(--font-heading--family, Georgia, 'Times New Roman', serif);
    font-weight: 600;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    letter-spacing: 0.01em;
    color: #3a1522;
    margin: 0;
  }

  .desire-promises__underline {
    display: block;
    width: 56px;
    height: 3px;
    border-radius: 2px;
    background: #8a2432;
    margin: 12px auto 0;
  }

  .desire-promises__sub {
    margin-top: 14px;
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgb(58 21 34 / 0.78);
  }

  .desire-promises__sub p {
    margin: 0;
  }

  .desire-promises__badge {
    display: inline-block;
    margin: 34px 0 0;
    padding: 9px 20px;
    border-radius: 999px;
    background: #8a2432;
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .desire-promises__grid {
    list-style: none;
    display: grid;
    gap: 16px;
    margin: 16px 0 0;
    padding: 0;
  }

  .desire-promises__card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: #211421;
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.5;
    border-radius: 14px;
    padding: 20px 22px;
    box-shadow: 0 12px 28px rgb(33 20 33 / 0.25);
  }

  .desire-promises__check {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #c05a7a;
    color: #fff;
    margin-top: 1px;
  }

  @media screen and (min-width: 750px) {
    .desire-promises__grid {
      grid-template-columns: 1fr 1fr;
    }

    .desire-promises__inner {
      padding: 72px 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Desire promises",
  "settings": [
    { "type": "color", "id": "background_color", "label": "Background", "default": "#C49AAD" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    { "type": "range", "id": "spacing_top", "label": "Top spacing (gap above section)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "spacing_bottom", "label": "Bottom spacing (gap below section)", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Waarom Desire17" },
    { "type": "richtext", "id": "subtext", "label": "Subtext", "default": "<p>Luxe essentials, zorgvuldig gekozen voor jouw comfort, verlangen en zelfvertrouwen.</p>" },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "DESIRE17 BELOFTES" },
    { "type": "text", "id": "card_1", "label": "Card 1 text", "default": "Discreet verpakt, altijd met respect voor jouw privacy" },
    { "type": "text", "id": "card_2", "label": "Card 2 text", "default": "Premium service en zorgvuldig geselecteerde essentials" }
  ],
  "presets": [{ "name": "Desire promises", "category": "Custom" }]
}
{% endschema %}
